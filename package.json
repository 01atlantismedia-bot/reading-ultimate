{
  "name": "aphrodite",
  "private": true,
  "type": "module",
  "scripts": {
    "passages": "node scripts/build-passages.mjs",
    "build": "node scripts/build-passages.mjs && node scripts/build-site.mjs",
    "dev": "npm run build && cd worker && wrangler dev -c wrangler.dev.toml --local --persist-to .wrangler/state",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
